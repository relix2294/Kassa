# Скопируй в .env и при необходимости поправь
PORT=4000
# Строка подключения к Postgres. На macOS c Homebrew обычно достаточно имени пользователя.
DATABASE_URL=postgres://aynifayzulloev@localhost:5432/kassa
# Внешняя база штрихкодов (опционально). Если пусто — название вводится вручную.
BARCODE_LOOKUP_URL=
# Секрет для подписи токенов входа. ОБЯЗАТЕЛЬНО поменяй на свой в проде.
JWT_SECRET=change-me-to-a-long-random-string

# Зона магазина (для «сегодня», итогов дня и расписания). По умолч. Asia/Dushanbe.
STORE_TIMEZONE=Asia/Dushanbe

# --- Telegram-уведомления (опционально) ---
# Токен бота от @BotFather. Пусто — уведомления выключены.
TELEGRAM_BOT_TOKEN=
# Id группы/чата. Узнать: добавь бота в группу, напиши там что-нибудь,
# затем: npm run tg:chatid  (для групп id обычно отрицательный).
TELEGRAM_CHAT_ID=
# Итог приходит МОМЕНТАЛЬНО при закрытии смены (сверка + итоги дня + баланс).
# Это поле — опциональный ДОПОЛНИТЕЛЬНЫЙ отчёт в фиксированное время (ЧЧ:ММ).
# Пусто — доп. отчёт выключен (только при закрытии смены).
TELEGRAM_DAILY_TIME=
# Порог «заканчивается товар»: уведомление, когда остаток падает ниже. По умолч. 4.
TELEGRAM_LOW_STOCK_THRESHOLD=4
# Слать ли уведомления об отменах на кассе (отмена позиции/очистка чека).
# Они бывают частыми — поставь false, если в группе становится шумно. По умолч. true.
TELEGRAM_NOTIFY_VOIDS=true
# «Крупный чек»: сумма, выше которой слать уведомление о продаже. 0 — выключено.
# Поставь, напр., 1000, чтобы видеть необычно большие чеки.
TELEGRAM_BIG_SALE=0
