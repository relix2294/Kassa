# === VPS-зеркало (витрина руководителя, только чтение) ===
# Скопируй в deploy/.env на VPS и подставь значения.

# Роль — зеркало: любые изменения заблокированы, доступны Кабинет и Аналитика,
# плюс приём снимков от магазина.
ROLE=mirror

# Профиль синхронизации НЕ включаем — зеркало снимки принимает, а не шлёт.
# (COMPOSE_PROFILES не указываем.)

# Внешний порт витрины на VPS (открываешь http://185.18.53.234:<порт>).
HOST_PORT=8080

# Секреты базы и токенов зеркала — свои, отдельные от магазина.
DB_PASS=ЗАМЕНИ_случайный_пароль
JWT_SECRET=ЗАМЕНИ_длинная_случайная_строка

# ОБЩИЙ секрет: ДОЛЖЕН совпадать с MIRROR_SECRET в .env магазина.
MIRROR_SECRET=ЗАМЕНИ_общий_секрет_для_зеркала
