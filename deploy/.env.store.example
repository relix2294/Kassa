# === Касса магазина (хозяин данных) ===
# Скопируй в deploy/.env на компьютере магазина и подставь значения.

# Роль — полноценная касса (можно не указывать, это значение по умолчанию).
ROLE=store

# Включает сервис синхронизации на VPS. Для магазина оставь как есть.
COMPOSE_PROFILES=store

# Внешний порт кассы на этом компе (открываешь http://localhost:<порт>).
HOST_PORT=8080

# Секреты базы и токенов. Сгенерируй свои:  openssl rand -hex 16 / -hex 32
DB_PASS=ЗАМЕНИ_случайный_пароль
JWT_SECRET=ЗАМЕНИ_длинная_случайная_строка

# --- Синхронизация с VPS-зеркалом ---
# Адрес приёма снимков на VPS. ТОЛЬКО https:// — снимок базы (включая хеши PIN
# и закупочные цены) и общий секрет нельзя слать по открытому HTTP. Настройте на
# зеркале TLS (reverse-proxy с сертификатом, напр. Caddy/nginx + Let's Encrypt).
MIRROR_URL=https://ВАШ_ДОМЕН_ЗЕРКАЛА/api/mirror/upload
# ОБЩИЙ секрет: должен совпадать со значением MIRROR_SECRET в .env зеркала.
MIRROR_SECRET=ЗАМЕНИ_общий_секрет_для_зеркала
# Как часто слать снимок, секунды (600 = 10 минут).
SYNC_INTERVAL=600
